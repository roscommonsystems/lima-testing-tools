# Copy this file to `secret_config.py` (which is gitignored) and fill in BOTH values
# below. This is the only file you need to set up.
#
# 1) FIREBASE_API_KEY - the Firebase Web API key, used to refresh your signed-in LIMA
#    session so the suite can fetch the API keys it needs.
#    Where to find it: Firebase console -> Project Settings -> General -> "Web API Key"
#    (ask the LIMA team which Firebase project this suite uses).
#
# 2) AUTH_URL - the base URL of the LIMA auth server (a GCP Cloud Run service).
#    Where to find it: ask the LIMA team, or copy it from the Cloud Run console for the
#    LIMA project.
#
# Both are read from this file. Alternatively, each can be supplied via an environment
# variable instead: LIMA_FIREBASE_API_KEY and LIMA_AUTH_URL.

FIREBASE_API_KEY = "AIza...your Firebase Web API key here..."
AUTH_URL = "https://YOUR-LIMA-AUTH-SERVER-URL"
