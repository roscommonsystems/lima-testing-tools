# Copy this file to `secret_config.py` (which is gitignored) and fill in ONE of the two
# options below. This is the only file you need to set up.
#
# OPTION 1 - paste an OpenRouter API key
#
#    OPEN_ROUTER_API_KEY - used directly for the suite's screenshot checks. When it is set,
#    the suite skips option 2 and the two values below are ignored.
#    Where to find it: https://openrouter.ai/settings/keys (give the key a credit limit).
#
# OPTION 2 - reuse your LIMA sign-in
#
#    Leave OPEN_ROUTER_API_KEY empty, sign into LIMA once, and fill in both:
#
#    1) FIREBASE_API_KEY - the Firebase Web API key, used to refresh your signed-in LIMA
#       session so the suite can fetch the API keys it needs.
#       Where to find it: Firebase console -> Project Settings -> General -> "Web API Key"
#       (ask the LIMA team which Firebase project this suite uses).
#
#    2) AUTH_URL - the base URL of the LIMA auth server (a GCP Cloud Run service).
#       Where to find it: ask the LIMA team, or copy it from the Cloud Run console for the
#       LIMA project.
#
# All values are read from this file. Alternatively, each can be supplied via an environment
# variable instead: LIMA_OPEN_ROUTER_API_KEY, LIMA_FIREBASE_API_KEY and LIMA_AUTH_URL.

OPEN_ROUTER_API_KEY = ""

FIREBASE_API_KEY = "AIza...your Firebase Web API key here..."
AUTH_URL = "https://YOUR-LIMA-AUTH-SERVER-URL"
