# Copy this file to `secret_config.py` (which is gitignored) and fill in the value below.
#
# As of LIMA 1.9.0.5 the app signs in with Google instead of a license key. This test
# suite reuses your signed-in LIMA session to fetch the API keys it needs. Refreshing
# that session requires the Firebase Web API key for the "roscommon-order-routing"
# project (Firebase console -> Project Settings -> General -> Web API Key). It ships
# inside every LIMA build and is not a true secret, but is kept out of git.
#
# Alternative: instead of this file, set the LIMA_FIREBASE_API_KEY environment variable.

FIREBASE_API_KEY = "AIza...your Firebase Web API key here..."
